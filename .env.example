# Copy this file to ".env.local" and paste your free Groq API key below.
# Get a free key at: https://console.groq.com/keys
#
# THE APP RUNS FULLY WITHOUT A KEY. With no key set, narrative chapters are
# drafted from Drafter's deterministic templates instead of a language model.
# Factual chapters are identical either way — they are always built directly
# from issuer data. This is deliberate, so a live demo can never fail.

GROQ_API_KEY=your_groq_key_here

# Model used on Groq (free tier). Optional.
GROQ_MODEL=llama-3.3-70b-versatile
